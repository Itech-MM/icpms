<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProfile name="dev">
        <property name="LOG_PATH" value="D:/FlexiTech/Company Data/Projects/ICPMS/admin-system/logs/api"/>
    </springProfile>
    <springProfile name="uat">
        <property name="LOG_PATH" value="/home/tomcat/icpms/logs/api"/>
    </springProfile>

    <property name="LOG_FILE" value="${LOG_PATH}/icpms-api.log"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/icpms-api-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- dev: verbose for our own code only, quiet for framework noise -->
    <springProfile name="dev">
        <logger name="org.flexitech.projects.icpms" level="DEBUG"/>
        <logger name="org.springframework" level="WARN"/>
        <logger name="org.springframework.security" level="INFO"/>
        <logger name="org.springframework.web" level="WARN"/>
        <logger name="org.hibernate" level="WARN"/>
        <logger name="org.hibernate.SQL" level="WARN"/>
        <logger name="com.zaxxer.hikari" level="WARN"/>
        <logger name="com.mysql.cj" level="WARN"/>
        <logger name="org.apache.tomcat" level="WARN"/>
        <logger name="org.apache.catalina" level="WARN"/>
        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <!-- prod: quieter, file only -->
    <springProfile name="prod">
        <logger name="org.flexitech.projects.icpms" level="INFO"/>
        <logger name="org.springframework.security" level="WARN"/>
        <root level="WARN">
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>
</configuration>